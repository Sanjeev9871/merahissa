# ---------------------------------------------------------------------------
# Mera Hissa environment. Copy to .env.local and fill. NEVER commit .env.local.
# ---------------------------------------------------------------------------

# Supabase --------------------------------------------------------------------
# The anon key is safe to expose to the browser ONLY because every table has
# row-level security. If you ever disable RLS on a table, this key becomes a
# full read of that table. Do not disable RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS entirely. Never expose to the browser, never prefix
# with NEXT_PUBLIC_, never log. Used only by the admin review queue and the
# scheduled purge job.
SUPABASE_SERVICE_ROLE_KEY=

# Column encryption -----------------------------------------------------------
# 32 bytes, base64. Generate with:  openssl rand -base64 32
# Encrypts government ID numbers at rest, separately from the database's own
# encryption, so a database dump alone does not yield ID numbers.
PII_ENCRYPTION_KEY=

# AI inference ----------------------------------------------------------------
# "groq" | "openrouter" — swap providers without touching application code.
AI_PROVIDER=groq
AI_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Razorpay (week 3) -----------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Upstash rate limiting (week 3) ----------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cron ------------------------------------------------------------------------
# Shared secret for the daily retention purge at /api/cron/purge.
# Vercel Cron sends it as `Authorization: Bearer <secret>`.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Ops -------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
